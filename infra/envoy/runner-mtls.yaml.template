# Render this template with envsubst before starting Envoy.
# It terminates runner mTLS and injects an authenticated SHA-256 client-cert fingerprint.
static_resources:
  listeners:
    - name: runner_mtls_listener
      address:
        socket_address: { address: 0.0.0.0, port_value: 8443 }
      filter_chains:
        - transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              require_client_certificate: true
              common_tls_context:
                tls_certificates:
                  - certificate_chain: { filename: /etc/clawcompany/tls/proxy.crt }
                    private_key: { filename: /etc/clawcompany/tls/proxy.key }
                validation_context:
                  trusted_ca: { filename: /etc/clawcompany/tls/runner-ca.pem }
          filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: runner_mtls
                route_config:
                  name: runner_routes
                  virtual_hosts:
                    - name: clawcompany
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/api/v15/runner/" }
                          route: { cluster: clawcompany_api }
                      request_headers_to_add:
                        - header:
                            key: X-Runner-Cert-Fingerprint
                            value: "%DOWNSTREAM_PEER_FINGERPRINT_256%"
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: X-ClawCompany-MTLS-Verified
                            value: "${RUNNER_MTLS_PROXY_SHARED_SECRET}"
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: clawcompany_api
      connect_timeout: 2s
      type: STRICT_DNS
      load_assignment:
        cluster_name: clawcompany_api
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: api, port_value: 8000 }
