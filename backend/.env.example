APP_NAME=ClawCompany API
ENV=development
DATABASE_URL=sqlite:///./clawcompany.db
CORS_ORIGINS=http://localhost:3000

# Auth / security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CUSTOMER_PORTAL_TOKEN_MINUTES=720

# OpenClaw runtime adapter
OPENCLAW_MODE=mock
OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
OPENCLAW_API_TOKEN=
OPENCLAW_TIMEOUT_SECONDS=30
OPENCLAW_RPC_CREATE_AGENT=agents.create
OPENCLAW_RPC_RUN_AGENT=agents.run
OPENCLAW_RPC_CANCEL_RUN=runs.cancel
OPENCLAW_RPC_GATEWAY_STATUS=gateway.status
OPENCLAW_RPC_SUBSCRIBE_RUN=runs.subscribe
OPENCLAW_EVENT_RUN_ID_KEY=runId
OPENCLAW_EVENT_TYPE_KEY=type

# Background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
APP_BASE_URL=http://localhost:8000

# Knowledge / vector search
VECTOR_BACKEND=pgvector
EMBEDDING_PROVIDER=hash384
EMBEDDING_DIM=384

# v10 agent-to-agent artifact handoff workspace
ARTIFACT_WORKSPACE_ROOT=./workspace-artifacts

# v11 Repository Delivery
REPOSITORY_WORKSPACE_ROOT=./workspace-repositories
REPOSITORY_TEST_ALLOWED_EXECUTABLES=python,python3,pytest,npm,pnpm,yarn,node
REPOSITORY_GIT_TIMEOUT_SECONDS=120
# Bind repository credentials with secret_ref=env:GITHUB_TOKEN. Never store the token in DB.
GITHUB_TOKEN=

# Durable event webhook outbox. Explicit allowlist prevents arbitrary SSRF destinations.
EVENT_WEBHOOK_ALLOWED_HOSTS=localhost,127.0.0.1
EVENT_WEBHOOK_TIMEOUT_SECONDS=10

# v12 Secure AI Development Cloud
DEV_WORKSPACE_ROOT=/workspace-dev
DEPLOYMENT_WORKSPACE_ROOT=/workspace-deployments
SANDBOX_DOCKER_ENABLED=false
SANDBOX_DOCKER_USER=65532:65532
SANDBOX_DEFAULT_PROVIDER=mock

# v13 AI Engineering Organization
# A microVM runner is intentionally NOT bundled. Point this at a separately deployed hardened runner adapter.
SANDBOX_MICROVM_GATEWAY_URL=
ENGINEERING_EVIDENCE_MAX_FILES=5000

# v14 Distributed Secure Execution
WORKLOAD_IDENTITY_ISSUER=http://localhost:8000/api/v14/workload-identity
# Development fallback only. Use RS256 + key paths in production.
WORKLOAD_IDENTITY_ALGORITHM=HS256
WORKLOAD_IDENTITY_KEY_ID=clawcompany-workload-v14
WORKLOAD_IDENTITY_DEV_SECRET=change-workload-identity-secret-in-production
WORKLOAD_IDENTITY_PRIVATE_KEY_PATH=
WORKLOAD_IDENTITY_PUBLIC_KEY_PATH=
SUPPLY_CHAIN_SIGNING_KEY=change-supply-chain-signing-key
TRAFFIC_ROUTER_CONFIG_ROOT=./workspace-traffic
TRAFFIC_ROUTER_ALLOW_EXTERNAL_PATH=false
TRAFFIC_ROUTER_KUBERNETES_ENABLED=false
TRAFFIC_ROUTER_KUBECTL_EXECUTABLE=kubectl

# v15 Production Trust, Telemetry & Autonomous SRE
# Put FastAPI behind an mTLS-capable private proxy (Envoy/NGINX) and set both values in production.
RUNNER_MTLS_REQUIRED=false
RUNNER_MTLS_PROXY_SHARED_SECRET=
TELEMETRY_EXPORT_ALLOWED_HOSTS=localhost,127.0.0.1
TELEMETRY_EXPORT_TIMEOUT_SECONDS=10
SECRET_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_PROVIDER_TIMEOUT_SECONDS=10
INCIDENT_PAGING_ALLOWED_HOSTS=localhost,127.0.0.1
INCIDENT_PAGING_TIMEOUT_SECONDS=10
SCHEDULER_NODE_KEY=control-plane-v15
